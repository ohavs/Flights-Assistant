rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: any signed-in user can READ profile data (for sharing
    // lookups + showing the owner's name on a shared trip). Only the
    // user themselves can WRITE their profile.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;

      // What only the user may see: the hash of their trip-delete code.
      match /private/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // The push tokens of the user's phones (N5): each phone lists itself
      // (src/lib/native/push.js); only the server reads them all.
      match /devices/{deviceId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Trips: role-based access.
    //   owner  — full control: edit content, change member roles, delete
    //   editor — edit content (cannot change membership)
    //   contributor ("הוספה", 8.70.0) — adds anything; changes and deletes
    //            only what they added (createdBy); ticks anyone's item
    //            (visited, packed, done); adds activities to the days
    //   viewer — read-only
    // memberIds is the canonical array used by the trip-list query.
    // members is a map {uid: role}.
    // Any member may "leave" the trip (remove themselves from both
    // members + memberIds); only an owner can delete the doc.
    // deleteAt (when a requested delete takes effect, 24 hours on; the
    // owner may cancel until then) is the owner's alone to set or clear.
    match /trips/{tripId} {

      function trip() { return resource.data; }
      function role(uid) {
        return trip().members[uid] is string ? trip().members[uid] : null;
      }
      function isMember(uid) {
        return uid in trip().memberIds || role(uid) != null;
      }
      function canEdit(uid) {
        // 'member' kept for legacy data — treated as editor.
        return role(uid) == 'owner' || role(uid) == 'editor' || role(uid) == 'member';
      }
      function isOwner(uid) {
        return role(uid) == 'owner';
      }
      function keepsDeleteAt() {
        return request.resource.data.get('deleteAt', null) == resource.data.get('deleteAt', null);
      }

      // Get: any member. A trip that does not exist on the server — not yet
      // committed (opened right after creating it, slow network, offline) or
      // just deleted — reads as "does not exist" instead of failing: reading
      // resource.data on a missing document is an error, the listener gets
      // permission-denied, and the Firestore SDK can then crash.
      allow get: if request.auth != null
        && (
          resource == null
          || (resource.data.memberIds != null && request.auth.uid in resource.data.memberIds)
          || (resource.data.members != null && resource.data.members[request.auth.uid] != null)
        );

      // List: any member (the trip-list query filters on memberIds)
      allow list: if request.auth != null
        && (
          (resource.data.memberIds != null && request.auth.uid in resource.data.memberIds)
          || (resource.data.members != null && resource.data.members[request.auth.uid] != null)
        );

      // Create: creator must include themselves with 'owner' role
      allow create: if request.auth != null
        && request.resource.data.members[request.auth.uid] == 'owner'
        && request.auth.uid in request.resource.data.memberIds;

      // Update: owner can change anything. Editor can change everything
      // EXCEPT members + memberIds. Any member may leave (remove self).
      allow update: if request.auth != null && (
        isOwner(request.auth.uid)
        || (
          canEdit(request.auth.uid)
          && request.resource.data.members == resource.data.members
          && request.resource.data.memberIds == resource.data.memberIds
          && keepsDeleteAt()
        )
        || (
          // Self-leave: must currently be a member, must NOT appear in
          // the new doc's members/memberIds.
          isMember(request.auth.uid)
          && !(request.auth.uid in request.resource.data.memberIds)
          && !(request.resource.data.members.keys().hasAny([request.auth.uid]))
          && keepsDeleteAt()
        )
      );

      // Delete: only owner
      allow delete: if request.auth != null && isOwner(request.auth.uid);

      // Subcollections — read for any member, write for editors+owners;
      // a contributor writes what is theirs (below).
      match /{subcollection}/{docId} {
        function parent() { return get(/databases/$(database)/documents/trips/$(tripId)).data; }
        function pRole(uid) {
          return parent().members[uid] is string ? parent().members[uid] : null;
        }
        function isEditor() {
          return pRole(request.auth.uid) == 'owner'
            || pRole(request.auth.uid) == 'editor'
            || pRole(request.auth.uid) == 'member';
        }
        function isContributor() { return pRole(request.auth.uid) == 'contributor'; }
        // Who added it. Places and bookings said so as addedBy before
        // createdBy; a reminder's addedByUid is whose it is, not who wrote it.
        function creatorOf(d) { return d.get('createdBy', d.get('addedBy', null)); }
        function addsHere() {
          return subcollection in ['planning', 'checklist', 'reminders', 'info', 'expenses', 'bookings'];
        }
        function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
        // A tick on anyone's item. A place also keeps its measured travel
        // times and position, which any phone fills in.
        function ticks() {
          return (subcollection == 'planning' && changed().hasOnly(['visited', 'distances', 'coords']))
            || ((subcollection == 'checklist' || subcollection == 'reminders') && changed().hasOnly(['completed']));
        }
        // A day's plan is its activities array (src/lib/dayActivities.js):
        // whatever went in or came out must be the contributor's own.
        function ownAct(list, i) { return list.size() <= i || list[i].get('createdBy', null) == request.auth.uid; }
        function ownActs(list) {
          return list.size() <= 8 && ownAct(list, 0) && ownAct(list, 1) && ownAct(list, 2) && ownAct(list, 3)
            && ownAct(list, 4) && ownAct(list, 5) && ownAct(list, 6) && ownAct(list, 7);
        }
        function ownActivities() {
          let before = resource.data.get('activities', []);
          let after = request.resource.data.get('activities', []);
          return changed().hasOnly(['activities'])
            && ownActs(after.removeAll(before)) && ownActs(before.removeAll(after));
        }

        allow read: if request.auth != null
          && (
            (parent().memberIds != null && request.auth.uid in parent().memberIds)
            || (parent().members != null && parent().members[request.auth.uid] != null)
          );

        allow create: if request.auth != null && (
          isEditor()
          || (isContributor() && addsHere() && request.resource.data.get('createdBy', null) == request.auth.uid)
        );
        allow update: if request.auth != null && (
          isEditor()
          || (isContributor() && addsHere() && (
                (creatorOf(resource.data) == request.auth.uid && creatorOf(request.resource.data) == request.auth.uid)
                || ticks()))
          || (isContributor() && subcollection == 'days' && ownActivities())
        );
        allow delete: if request.auth != null && (
          isEditor()
          || (isContributor() && addsHere() && creatorOf(resource.data) == request.auth.uid)
        );
      }
    }
  }
}
