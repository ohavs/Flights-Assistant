<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- The launcher entry is the activity itself, with the map icon
             (8.40.0). Icons are no longer switched: a component whose state
             was never changed at runtime, so no phone is left without one. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".AppActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Share" from Google Maps (or anywhere that shares text): the
                 app is in the list and opens on the trip picker
                 (AppToolsPlugin "shared", ShareTargetScreen). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- The activity's old name, no longer a launcher entry: an intent
             made before 8.40.0 (a scheduled notification) still opens the app. -->
        <activity-alias
            android:name=".MainActivity"
            android:targetActivity=".AppActivity"
            android:exported="true" />

        <!-- The home screen widgets (widget/). TripWidget keeps its name: a
             widget already on a home screen is tied to it. -->
        <receiver
            android:name=".widget.TripWidget"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/trip_widget" />
        </receiver>
        <receiver
            android:name=".widget.CountdownWidget"
            android:exported="false"
            android:label="@string/widget_countdown_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/countdown_widget" />
        </receiver>
        <receiver
            android:name=".widget.PlanWidget"
            android:exported="false"
            android:label="@string/widget_plan_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/plan_widget" />
        </receiver>
        <receiver
            android:name=".widget.PackWidget"
            android:exported="false"
            android:label="@string/widget_pack_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pack_widget" />
        </receiver>
        <receiver
            android:name=".widget.RemindersWidget"
            android:exported="false"
            android:label="@string/widget_rem_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/reminders_widget" />
        </receiver>

        <receiver
            android:name=".widget.ExpenseWidget"
            android:exported="false"
            android:label="@string/widget_expense_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/expense_widget" />
        </receiver>
        <!-- The expense widget's second step, over the home screen: its own
             task, so the app does not come up behind it. -->
        <activity
            android:name=".widget.ExpenseSheetActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.expense"
            android:theme="@style/ExpenseSheet"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <!-- The plan and reminders lists (ListWidgetService), and a tap on one
             of their rows: a tick, or the app opened there. No screen. -->
        <service
            android:name=".widget.ListWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <activity
            android:name=".widget.WidgetActionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity="${applicationId}.widgetaction"
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- Wakes the widgets at midnight and around flights (WidgetClock). -->
        <receiver
            android:name=".widget.WidgetClock"
            android:exported="false" />
        <!-- Sends what the widgets queued offline, once there is a network. -->
        <service
            android:name=".widget.ExpenseFlushJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- CI screenshots of the widgets (not exported: adb as root only). -->
        <activity
            android:name=".widget.WidgetPreviewActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- In-app updates: install the APK downloaded from GitHub Releases. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
