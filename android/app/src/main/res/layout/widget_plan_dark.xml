<?xml version="1.0" encoding="utf-8"?>
<!-- Written by scripts/widget-layouts.py; edit there. widget_plan, always dark (the app set to dark). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <FrameLayout
            android:id="@+id/icon_tile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_soft_dark">
            <ImageView
                android:id="@+id/icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_ws_map_dark"
                android:importantForAccessibility="no"
                android:layout_gravity="center" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_marginStart="10dp">
            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/WBold.Title"
                android:textColor="@color/w_text_dark" />
            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/WText.Muted"
                android:layout_marginTop="3dp"
                android:textColor="@color/w_muted_dark" />
        </LinearLayout>
        <TextView
            android:id="@+id/chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/WBold.Chip"
            android:layout_marginStart="8dp"
            android:textColor="@color/w_accent_dark"
            android:background="@drawable/widget_chip_dark" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp">
        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none"
            android:listSelector="@android:color/transparent" />
        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/WText.Muted"
            android:gravity="center"
            android:textSize="15sp"
            android:visibility="gone"
            android:textColor="@color/w_muted_dark" />
    </FrameLayout>
</LinearLayout>
