<?xml version="1.0" encoding="utf-8"?>
<!-- Written by scripts/widget-layouts.py; edit there. The trip widget (TripWidget): the next flight with its airports big, or during the trip today's plan; packing and reminders in two tiles. WidgetKit sizes it. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <FrameLayout
            android:id="@+id/icon_tile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_soft">
            <ImageView
                android:id="@+id/icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_ws_plane"
                android:importantForAccessibility="no"
                android:layout_gravity="center" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_marginStart="10dp">
            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/WBold.Title" />
            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/WText.Muted"
                android:layout_marginTop="3dp" />
        </LinearLayout>
        <TextView
            android:id="@+id/chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/WBold.Chip"
            android:layout_marginStart="8dp" />
    </LinearLayout>
    <FrameLayout
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp">
        <LinearLayout
            android:id="@+id/flight_block"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_vertical">
            <LinearLayout
                android:id="@+id/route_row"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:layoutDirection="ltr"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/from"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    style="@style/WBold.Hero"
                    android:layout_weight="1"
                    android:gravity="left|center_vertical"
                    android:textAlignment="gravity" />
                <ImageView
                    android:id="@+id/route_line"
                    android:layout_width="64dp"
                    android:layout_height="24dp"
                    android:src="@drawable/widget_route"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:scaleType="fitCenter" />
                <TextView
                    android:id="@+id/to"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    style="@style/WBold.Hero"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:textAlignment="gravity" />
            </LinearLayout>
            <TextView
                android:id="@+id/when"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/WText"
                android:textSize="15sp"
                android:layout_marginTop="2dp" />
            <TextView
                android:id="@+id/flight_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/WText.Muted"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/plan_block"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/plan_row_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/plan_time_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/WBold.Pill" />
                <ImageView
                    android:id="@+id/plan_ring_1"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/widget_dot"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/plan_title_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    style="@style/WText"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/plan_row_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/plan_time_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/WBold.Pill" />
                <ImageView
                    android:id="@+id/plan_ring_2"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/widget_dot"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/plan_title_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    style="@style/WText"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/plan_row_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/plan_time_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/WBold.Pill" />
                <ImageView
                    android:id="@+id/plan_ring_3"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/widget_dot"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/plan_title_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    style="@style/WText"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/plan_row_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/plan_time_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/WBold.Pill" />
                <ImageView
                    android:id="@+id/plan_ring_4"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/widget_dot"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/plan_title_4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    style="@style/WText"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/plan_row_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/plan_time_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/WBold.Pill" />
                <ImageView
                    android:id="@+id/plan_ring_5"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/widget_dot"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/plan_title_5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    style="@style/WText"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/plan_row_6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/plan_time_6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/WBold.Pill" />
                <ImageView
                    android:id="@+id/plan_ring_6"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/widget_dot"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/plan_title_6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    style="@style/WText"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
            <TextView
                android:id="@+id/plan_more"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/WText.Muted"
                android:layout_marginTop="6dp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:id="@+id/bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">
        <LinearLayout
            android:id="@+id/packed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:background="@drawable/widget_tile"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/packed_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_ws_checklist"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/packed_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/WBold"
                    android:layout_marginStart="7dp" />
                <TextView
                    android:id="@+id/packed_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    style="@style/WText.Muted"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp" />
            </LinearLayout>
            <ProgressBar
                android:id="@+id/packed_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progressDrawable="@drawable/widget_progress" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="8dp"
            android:layout_height="1dp" />
        <LinearLayout
            android:id="@+id/rem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:background="@drawable/widget_tile"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/rem_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_ws_bell"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/rem_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/WBold"
                    android:layout_marginStart="7dp" />
                <TextView
                    android:id="@+id/rem_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    style="@style/WText.Muted"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp" />
            </LinearLayout>
            <TextView
                android:id="@+id/rem_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/WText.Muted"
                android:textSize="12sp"
                android:layout_marginTop="5dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
