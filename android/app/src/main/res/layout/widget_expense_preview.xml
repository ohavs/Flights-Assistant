<?xml version="1.0" encoding="utf-8"?>
<!-- Written by scripts/widget-layouts.py; edit there. The widget picker's preview: widget_expense with sample text. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="13dp"
    android:paddingEnd="13dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <FrameLayout
            android:id="@+id/icon_tile"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_soft">
            <ImageView
                android:id="@+id/icon"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:src="@drawable/ic_ws_wallet"
                android:importantForAccessibility="no"
                android:layout_gravity="center" />
        </FrameLayout>
        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            style="@style/WText.Muted"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="הוצאה · פריז עם הילדים" />
    </LinearLayout>
    <TextView
        android:id="@+id/amount"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        style="@style/WBold.Hero"
        android:layout_marginTop="4dp"
        android:gravity="start|center_vertical"
        android:autoSizeMaxTextSize="40sp"
        android:text="42.50 €" />
    <LinearLayout
        android:id="@+id/keypad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:layout_weight="1"
        android:layout_marginTop="5dp"
        android:layoutDirection="ltr">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:layout_weight="1">
            <TextView
                android:id="@+id/key_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                style="@style/WBold.Key"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_margin="3dp"
                android:background="@drawable/widget_tile"
                android:text="1" />
            <TextView
                android:id="@+id/key_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                style="@style/WBold.Key"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_margin="3dp"
                android:background="@drawable/widget_tile"
                android:text="2" />
            <TextView
                android:id="@+id/key_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                style="@style/WBold.Key"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_margin="3dp"
                android:background="@drawable/widget_tile"
                android:text="3" />
            <TextView
                android:id="@+id/key_cur"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                style="@style/WBold.Key.Cur"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_margin="3dp"
                android:background="@drawable/widget_chip"
                android:text="EUR" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:layout_weight="3">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_weight="3">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:orientation="horizontal"
                    android:layout_weight="1">
                    <TextView
                        android:id="@+id/key_4"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        style="@style/WBold.Key"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:layout_margin="3dp"
                        android:background="@drawable/widget_tile"
                        android:text="4" />
                    <TextView
                        android:id="@+id/key_5"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        style="@style/WBold.Key"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:layout_margin="3dp"
                        android:background="@drawable/widget_tile"
                        android:text="5" />
                    <TextView
                        android:id="@+id/key_6"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        style="@style/WBold.Key"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:layout_margin="3dp"
                        android:background="@drawable/widget_tile"
                        android:text="6" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:orientation="horizontal"
                    android:layout_weight="1">
                    <TextView
                        android:id="@+id/key_7"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        style="@style/WBold.Key"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:layout_margin="3dp"
                        android:background="@drawable/widget_tile"
                        android:text="7" />
                    <TextView
                        android:id="@+id/key_8"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        style="@style/WBold.Key"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:layout_margin="3dp"
                        android:background="@drawable/widget_tile"
                        android:text="8" />
                    <TextView
                        android:id="@+id/key_9"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        style="@style/WBold.Key"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:layout_margin="3dp"
                        android:background="@drawable/widget_tile"
                        android:text="9" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:orientation="horizontal"
                    android:layout_weight="1">
                    <TextView
                        android:id="@+id/key_dot"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        style="@style/WBold.Key"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:layout_margin="3dp"
                        android:background="@drawable/widget_tile"
                        android:text="." />
                    <TextView
                        android:id="@+id/key_0"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        style="@style/WBold.Key"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:layout_margin="3dp"
                        android:background="@drawable/widget_tile"
                        android:text="0" />
                    <TextView
                        android:id="@+id/key_back"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        style="@style/WBold.Key"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:layout_margin="3dp"
                        android:background="@drawable/widget_tile"
                        android:text="⌫" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:id="@+id/key_save"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                style="@style/WBold.Key.Save"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_margin="3dp"
                android:background="@drawable/widget_brand"
                android:text="המשך" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
