<?xml version="1.0" encoding="utf-8"?>
<!-- Written by scripts/widget-layouts.py; edit there. The widget picker's preview: widget_bookings with sample text. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <FrameLayout
            android:id="@+id/icon_tile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_soft">
            <ImageView
                android:id="@+id/icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_ws_ticket"
                android:importantForAccessibility="no"
                android:layout_gravity="center" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_marginStart="10dp">
            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/WBold.Title"
                android:text="הזמנות" />
            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/WText.Muted"
                android:layout_marginTop="3dp"
                android:text="פריז עם הילדים" />
        </LinearLayout>
        <TextView
            android:id="@+id/chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/WBold.Chip"
            android:layout_marginStart="8dp"
            android:text="4 קרובות" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:layout_weight="1"
        android:layout_marginTop="4dp">
        <LinearLayout
            android:id="@+id/bk_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/bk_ring_1"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/widget_dot"
                android:importantForAccessibility="no"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp" />
            <TextView
                android:id="@+id/bk_title_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/WText"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="סיור בלובר" />
            <TextView
                android:id="@+id/bk_time_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/WBold.Pill"
                android:layout_marginStart="8dp"
                android:text="10:00" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/bk_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/bk_ring_2"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/widget_dot"
                android:importantForAccessibility="no"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp" />
            <TextView
                android:id="@+id/bk_title_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/WText"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="ארוחת ערב ליד הסיין" />
            <TextView
                android:id="@+id/bk_time_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/WBold.Pill"
                android:layout_marginStart="8dp"
                android:text="20:30" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/bk_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/bk_ring_3"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/widget_dot"
                android:importantForAccessibility="no"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp" />
            <TextView
                android:id="@+id/bk_title_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/WText"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="שייט בסיין" />
            <TextView
                android:id="@+id/bk_time_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/WBold.Pill"
                android:layout_marginStart="8dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
