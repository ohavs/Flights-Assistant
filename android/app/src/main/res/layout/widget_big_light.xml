<?xml version="1.0" encoding="utf-8"?>
<!-- Written by scripts/widget-layouts.py; edit there. widget_big, always light (the app set to light). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_light"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <FrameLayout
            android:id="@+id/icon_tile"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_soft_light">
            <ImageView
                android:id="@+id/icon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/ic_ws_plane_light"
                android:importantForAccessibility="no"
                android:layout_gravity="center" />
        </FrameLayout>
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/WBold.Chip"
            android:layout_marginStart="6dp"
            android:textColor="@color/w_accent_light"
            android:background="@drawable/widget_chip_light" />
    </LinearLayout>
    <TextView
        android:id="@+id/big"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        style="@style/WBold.Hero"
        android:layout_weight="1"
        android:gravity="start|center_vertical"
        android:autoSizeMaxTextSize="72sp"
        android:textColor="@color/w_text_light" />
    <TextView
        android:id="@+id/caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/WText.Muted"
        android:maxLines="2"
        android:textColor="@color/w_muted_light" />
</LinearLayout>
