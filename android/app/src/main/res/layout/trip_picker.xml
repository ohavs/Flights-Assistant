<?xml version="1.0" encoding="utf-8"?>
<!-- Which trip a widget shows (WidgetTripActivity): over the home screen,
     when a widget is added there or set again; the expense widget also sets
     its keypad's currencies here, and saves. Colours per palette in code.
     A long list scrolls inside the sheet, which stays below the status bar. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000"
    android:layoutDirection="rtl">

    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginTop="56dp"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="18dp">

        <View
            android:id="@+id/handle"
            android:layout_width="40dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/rubik_extrabold"
            android:text="לאיזה טיול הווידג׳ט?"
            android:textAlignment="viewStart"
            android:textColor="@color/w_text"
            android:textSize="22sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/rubik_semibold"
            android:text="אפשר לשנות אחר כך בלחיצה ארוכה על הווידג׳ט"
            android:textAlignment="viewStart"
            android:textColor="@color/w_muted"
            android:textSize="14sp" />

        <ScrollView
            android:id="@+id/rows_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/done"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/rubik_extrabold"
            android:gravity="center"
            android:text="שמירה"
            android:textColor="@color/w_on_brand"
            android:textSize="18sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
