<?xml version="1.0" encoding="utf-8"?>
<!-- The trip widget, 4x2: the next flight and a countdown, or during the
     trip today's plan; packing and open reminders below. Narrow, a big countdown. It draws from the snapshot the app saves (TripWidgetPlugin)
     and redraws every half hour, so it moves on with the app closed. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.ohavs.flightsassistant.widget.WidgetTripActivity"
    android:widgetFeatures="reconfigurable"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_message"
    android:previewLayout="@layout/widget_trip_preview"
    android:previewImage="@mipmap/ic_launcher"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
