<?xml version="1.0" encoding="utf-8"?>
<!-- Backups and device transfer (Android 12 and up): everything but the
     sign-in the expense widget saves with (ExpenseStore). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="expense_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="expense_auth.xml" />
    </device-transfer>
</data-extraction-rules>
